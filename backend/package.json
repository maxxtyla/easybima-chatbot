{
  "name": "easybima-backend",
  "version": "1.0.0",
  "description": "Bima AI Chatbot Backend for CIC Insurance Group",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "db:setup": "node database/setup.js",
    "db:migrate": "psql -f database/schema.sql",
    "db:migrate:sessions": "node database/migration-session-management.js",
    "db:migrate:ticketing": "psql -f database/migrations/2026_07_add_ticketing.sql",
    "db:seed:agent": "node database/seed-agent.js",
    "test:sessions": "node test-session-management.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "twilio": "^5.3.0",
    "uuid": "^9.0.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}